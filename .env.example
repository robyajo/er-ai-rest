# Server Configuration
PORT=8060
HOST=0.0.0.0

# Optional: Bearer Token Authentication
# API_KEY=your-secret-api-key

# Default Provider: 'agy' or 'llamacpp'
DEFAULT_PROVIDER=agy

# Path to Antigravity CLI binary
AGY_PATH=/home/roby/.local/bin/agy

# llama.cpp Configuration
# Mode 1: HTTP API server (e.g. launched with `llama serve -m <model.gguf>`)
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080

# Mode 2: Direct CLI binary execution fallback
LLAMA_BIN=/Users/robykartis/.local/bin/llama
LLAMA_MODEL_PATH=/path/to/your/model.gguf
