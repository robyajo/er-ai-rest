# Server Configuration
PORT=8060
HOST=0.0.0.0

# Path to Antigravity CLI binary
AGY_PATH=/home/roby/.local/bin/agy

# Master API Key (Full access to all models - Antigravity & llama.cpp)
API_KEY=your-master-api-key

# Dedicated API Key for Antigravity (Gemini, Claude, GPT-OSS only)
AGY_API_KEY=your-antigravity-api-key

# Dedicated API Key for llama.cpp (Local GGUF models only)
LLAMA_API_KEY=your-llamacpp-api-key

# Default Engine Provider ('agy' or 'llamacpp')
DEFAULT_PROVIDER=agy

# llama.cpp Configuration
# Mode 1: Connect to llama-server HTTP API
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080

# Mode 2: Direct CLI binary fallback
LLAMA_BIN=/Users/robykartis/.local/bin/llama
LLAMA_MODEL_PATH=/path/to/your/model.gguf
